# Copiar a ".env" (no subir .env a Git).

WP_BASE_URL=https://tu-sitio.com
WP_USERNAME=tu_usuario
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Opcional — Google Search Console (herramientas gsc_top_pages / gsc_top_queries).
# GSC_SITE_URL debe coincidir con la propiedad en Search Console (ej. sc-domain:ejemplo.com o https://www.ejemplo.com/).
# Autenticación: elige OAuth (tres variables) O cuenta de servicio (JSON en una línea).

# GSC_SITE_URL=https://www.tu-sitio.com/

# GSC_OAUTH_CLIENT_ID=
# GSC_OAUTH_CLIENT_SECRET=
# GSC_OAUTH_REFRESH_TOKEN=

# JSON completo de la cuenta de servicio en una línea (escapando comillas si hace falta):
# GSC_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
